# Production Environment Variables Template
# Copy this file to .env on your production server and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=madness_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_PASSWORD
POSTGRES_DB=madness_carlo
DATABASE_URL=postgresql://madness_user:CHANGE_THIS_TO_SECURE_RANDOM_PASSWORD@db:5432/madness_carlo

# Generate secure password:
# openssl rand -hex 16

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# Application Security
# ============================================
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Generate secure secret key:
# openssl rand -hex 32

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# IMPORTANT: Update OAuth redirect URIs in Google Cloud Console:
# Authorized JavaScript origins: https://your-domain.com
# Authorized redirect URIs: https://your-domain.com/auth/callback

# ============================================
# Domain and URLs
# ============================================
# Your actual domain name (without https://)
DOMAIN=madnesscarlo.yourdomain.com

# Full URLs (with protocol)
FRONTEND_URL=https://madnesscarlo.yourdomain.com
BACKEND_URL=https://madnesscarlo.yourdomain.com

# ============================================
# SSL/Let's Encrypt Configuration
# ============================================
# Email for Let's Encrypt notifications (certificate expiry, etc.)
CERTBOT_EMAIL=your-email@example.com

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=production
NODE_ENV=production

# ============================================
# Optional: Email Configuration (Future)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Optional: Monitoring (Future)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=INFO

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real values to git
# 2. Keep the .env file secure and backed up
# 3. Use strong, random passwords for production
# 4. Make sure your domain DNS is configured before deployment
# 5. Update Google OAuth redirect URIs to match your domain

